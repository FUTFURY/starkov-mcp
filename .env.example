# ============================================================================
# 1. STARKOV MCP CLIENT CONFIGURATION (Claude Desktop / Cursor / Antigravity)
# ============================================================================
# Generate your personal MCP key at: https://starkov-app.vercel.app/doc?section=mcp-copilot
STARKOV_MCP_TOKEN=stk_mcp_your_personal_token_here
STARKOV_MCP_URL=https://starkov-app.vercel.app/api/mcp

# ============================================================================
# 2. STARKOV NON-CUSTODIAL LIVE EXECUTION RELAY (starkov-relay.mjs)
# ============================================================================
# Generate your bot relay token via `starkov_prepare_live_deployment` in MCP
# or by clicking the "Deploy" button on https://starkov-app.vercel.app/bots
STARKOV_BOT_TOKEN=stk_live_your_bot_relay_token_here
STARKOV_RELAY_URL=https://starkov-app.vercel.app/api/bots/relay
EXCHANGE_TARGET=kalshi
DRY_RUN=false
PORT=8080

# --- Kalshi v2 Portfolio API Credentials (Self-Custody Only) ---
KALSHI_API_KEY_ID=your_kalshi_key_id
KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# --- Polymarket CLOB L2 Credentials (Self-Custody Only) ---
POLY_ADDRESS=0xYourPolygonWalletAddress
POLY_API_KEY=your_poly_api_key
POLY_SECRET=your_poly_secret
POLY_PASSPHRASE=your_poly_passphrase
